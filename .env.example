TYPESAFE_API_KEY=
OPENAI_API_KEY=
ANSWER_MODEL=gpt-6-luna

# Local proxy only; never use VITE_* for secrets.
BOARD_REMOTE_URL=
BOARD_API_TOKEN=

# Railway only: persistent mount and private Jev profile.
DATA_DIR=/data
# PORT and RAILWAY_VOLUME_MOUNT_PATH are injected by Railway.
PROFILE_TEXT=
POLL_INTERVAL_SECONDS=300
POLL_BOARD_LIMIT=50
POLL_ASSESSMENT_LIMIT=50
